# ─────────────────────────────────────────────────────────────────────────────
# SchoolDesk Pro — کش یک‌ساعتهٔ JS (V4.209.0)
# ─────────────────────────────────────────────────────────────────────────────
# باندل‌های هش‌دار در assets/cache کش یک‌سالهٔ immutable دارند و این فایل به
# آن‌ها کاری ندارد. اینجا فقط فایل‌های «بی‌نسخه» مثل session-watch.js هستند؛ یک ساعت
# کش یعنی رفت‌وبرگشت 304 در ناوبری حذف می‌شود، ولی اصلاحیه‌ها هم همان روز
# اعمال می‌شوند (اگر پوشهٔ cache قابل نوشتن نبود و سایت به حالت بدون باندل
# برگشت، این مسیر فعال می‌شود).
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
</IfModule>
