# ─────────────────────────────────────────────────────────────────────────────
# SchoolDesk Pro — تنظیمات پایهٔ Apache (نسخهٔ V4.209.0)
# ─────────────────────────────────────────────────────────────────────────────
# این فایل امنیت پایه و «سرعت پیش‌فرض» را با هم می‌آورد. همهٔ بلوک‌ها با
# <IfModule> محافظت شده‌اند؛ روی سروری که آن ماژول را ندارد، هیچ خطایی نمی‌دهد.

Options -Indexes
DirectoryIndex index.php

# ── نوع MIME درست دارایی‌ها ──
# بدون این بلوک، بعضی هاست‌ها فونت را با application/octet-stream می‌فرستند؛
# آن‌وقت preload با type="font/woff2" تطبیق نمی‌خورد و مرورگر فایل را دو بار
# می‌گیرد. این همان چیزی است که در trace واقعی دیده شد.
<IfModule mod_mime.c>
    AddType font/woff2          .woff2
    AddType font/woff           .woff
    AddType font/ttf            .ttf
    AddType application/javascript .js
    AddType image/svg+xml       .svg
</IfModule>

# ── فشرده‌سازی ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── کش دارایی‌ها ──
# باندل‌های هش‌دار (assets/cache) و فونت‌ها و CSS/JS بی‌نسخه، هر کدام
# .htaccess اختصاصی خودشان را دارند؛ اینجا فقط تصاویر و آیکون‌ها.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/png     "access plus 7 days"
    ExpiresByType image/jpeg    "access plus 7 days"
    ExpiresByType image/webp    "access plus 7 days"
    ExpiresByType image/x-icon  "access plus 7 days"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:config|includes|sql|vendor|backups)(?:/|$) - [F,L,NC]
    RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)(?:/|$) - [F,L,NC]
</IfModule>

# ── فایل استاتیک گم‌شده نباید کل برنامه را اجرا کند ──
# روی هاستی که همه‌چیز را به index.php می‌فرستد، یک فونت گم‌شده هم PHP را
# بالا می‌آورد (در trace واقعی ۷۲۵ میلی‌ثانیه). اینجا مستقیم ۴۰۴ می‌شود.
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(assets|uploads)/ - [R=404,L]
</IfModule>

# ── فایل‌های حساس ──
<FilesMatch "(?i)\.(sqlite(?:3|-wal|-shm)?|db|sql|ini|log|bak|backup|env|lock|py|md|json)$">
    Require all denied
</FilesMatch>

AddDefaultCharset UTF-8
