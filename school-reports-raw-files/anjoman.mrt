          <value>domain,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>office_school</Name>
        <NameInSource>nazemonwebConnectionString</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_schoolID,,8,0</value>
        </Parameters>
        <SqlCommand>SELECT schools.name AS schoolName, offices.name AS officeName,schools.manager,domain
	FROM schools 
	INNER JOIN offices ON offices.ID = schools.officeID
WHERE schools.ID = @schoolID</SqlCommand>
      </office_school>
