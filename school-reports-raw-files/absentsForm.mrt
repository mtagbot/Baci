    <DataSources isList="true" count="2">
      <usp_GetSchoolClasses Ref="3" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>usp_GetSchoolClasses</Alias>
        <Columns isList="true" count="6">
          <value>schoolGradesCoursesID,System.Int32</value>
          <value>totalClass,System.Byte</value>
