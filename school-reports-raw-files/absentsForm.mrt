        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>usp_GetSchoolClasses</Name>
        <NameInSource>nazemonwebConnectionString</NameInSource>
        <Parameters isList="true" count="2">
          <value>_x0040_yearID,,8,0</value>
          <value>_x0040_schoolID,,8,0</value>
        </Parameters>
        <SqlCommand>execute usp_GetSchoolClasses @yearID,@schoolID</SqlCommand>
      </usp_GetSchoolClasses>
      <school Ref="4" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>school</Alias>
        <Columns isList="true" count="2">
          <value>schoolName,System.String</value>
          <value>officeName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>school</Name>
        <NameInSource>nazemonwebConnectionString</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_schoolID,,8,0</value>
        </Parameters>
        <SqlCommand>SELECT schools.name AS schoolName, offices.name AS officeName
	FROM schools 
	INNER JOIN offices ON offices.ID = schools.officeID
WHERE schools.ID = @schoolID</SqlCommand>
      </school>
